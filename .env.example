# Copy to .env for local development. Never commit .env or real credentials.
NODE_ENV=changes-required

# Database (configure when the API workspace is added)
DATABASE_URL=

# Redis / background jobs
REDIS_URL=

# AI provider (use server-side secrets only)
AI_PROVIDER=changes-required
AI_API_KEY=changes-required

# Stellar network configuration
STELLAR_NETWORK=changes-required
STELLAR_RPC_URL=changes-required
STELLAR_NETWORK_PASSPHRASE=changes-required
SOROBAN_RECEIPT_CONTRACT_ID=changes-required

# Application URLs
WEB_APP_URL=changes-required
API_BASE_URL=changes-required
