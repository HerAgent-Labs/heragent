# Copy to .env for local development. Never commit .env or real credentials.
NODE_ENV=development

# Database (configure when the API workspace is added)
DATABASE_URL=

# Redis / background jobs
REDIS_URL=

# AI provider (use server-side secrets only)
AI_PROVIDER=
AI_API_KEY=

# Stellar network configuration
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=
STELLAR_NETWORK_PASSPHRASE=
SOROBAN_RECEIPT_CONTRACT_ID=

# Application URLs
WEB_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000
